{
  "fastmail": {
    "token_file": "~/.config/jmapsync/fastmail-token",
    "session_endpoint": "https://api.fastmail.com/jmap/session",
    "include_mailboxes": []
  },
  "gmail": {
    "credentials_file": "~/.config/jmapsync/google-client.json",
    "token_file": "~/.config/jmapsync/google-token.json",
    "user": "me"
  },
  "state_file": "~/.local/state/jmapsync/state.json",
  "delete": true,
  "role_labels": {
    "archive": "Fastmail_Archive",
    "trash": "Fastmail_Trash",
    "junk": "Fastmail_Spam"
  }
}

